{
  "name": "ultraterrestrial",
  "workspaces": [
    "apps/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "start": "turbo run start",
    "dev": "turbo dev --parallel",
    "dev:app": "turbo dev --filter=@ultraterrestrial/app",
    "dev:lab": "turbo dev --filter=@ultraterrestrial/agentic-lab",
    "build:app": "turbo build --filter=@ultraterrestrial/app",
    "dev:stream": "turbo dev --filter=@ultraterrestrial/agentic-stream",
    "typecheck": "turbo typecheck",
    "new": "plop"
  },
  "packageManager": "bun@1.1.29",
  "dependencies": {
    "@tailwindcss/postcss": "^4.0.12",
    "cheerio": "^1.0.0",
    "fast-xml-parser": "^4.5.1",
    "next": "^15.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind": "^4.0.0",
    "turbo": "^2.4.1",
    "twitter-api-v2": "^1.19.1",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss7-compat": "^2.2.17",
    "autoprefixer": "^9",
    "postcss": "^8.5.3"
  }
}