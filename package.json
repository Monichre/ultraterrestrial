{
  "name": "ultraterrestrial",
  "workspaces": [
    "apps/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "start": "turbo run start",
    "dev": "turbo dev --parallel",
    "dev:app": "turbo dev --filter=@ultraterrestrial/app",
    "dev:lab": "turbo dev --filter=@ultraterrestrial/agentic-lab",
    "build:app": "turbo build --filter=@ultraterrestrial/app",
    "dev:stream": "turbo dev --filter=@ultraterrestrial/agentic-stream",
    "typecheck": "turbo typecheck",
    "new": "plop"
  },
  "packageManager": "bun@1.1.29",
  "dependencies": {
    "turbo": "^2.4.1",
    "typescript": "^5.7.3",
    "twitter-api-v2": "^1.19.1",
    "cheerio": "^1.0.0",
    "zod": "^3.24.2",
    "fast-xml-parser": "^4.5.1"
  }
}